{
  "schema_version": 1,
  "run_id": "vace_1p3b_lora_train_v001",
  "task": "training",
  "hypothesis": "少量授权训练片段能完成VACE条件模块LoRA训练、保存与后续回载",
  "manifest": "data/manifests/pilot.jsonl",
  "split": "train",
  "backend": {
    "kind": "command",
    "command": [
      "{python}",
      "scripts/adapters/diffsynth_train.py",
      "--request",
      "{request}"
    ]
  },
  "resources": {
    "gpus": 8,
    "timeout_s": 7200,
    "max_gpu_hours": 16
  },
  "expected_artifacts": [
    "*.safetensors"
