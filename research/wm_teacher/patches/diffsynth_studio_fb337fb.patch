diff --git a/diffsynth/diffusion/runner.py b/diffsynth/diffusion/runner.py
index 0e2c921..ca58197 100644
--- a/diffsynth/diffusion/runner.py
+++ b/diffsynth/diffusion/runner.py
@@ -63,8 +63,28 @@ def launch_training_task(
 
     optimizer_class = get_optimizer_class(customized_optimizer)
     optimizer = optimizer_class(model.trainable_modules(), lr=learning_rate, weight_decay=weight_decay)
-    scheduler = torch.optim.lr_scheduler.ConstantLR(optimizer)
     dataloader = torch.utils.data.DataLoader(dataset, shuffle=True, collate_fn=lambda x: x[0], num_workers=num_workers)
+    if getattr(args, "lr_scheduler", "constant") == "cosine":
+        import math
+        # accelerate's AcceleratedScheduler calls scheduler.step() num_processes times per optimizer
+        # step (split_batches=False), so count in those units: the un-sharded dataloader length.
+        # Under DeepSpeed the engine itself steps the scheduler once per optimizer step (accelerate's
+        # DeepSpeedSchedulerWrapper.step is a no-op), so count in optimizer steps there.
+        from accelerate.utils import DistributedType
+        k = 1 if accelerator.distributed_type == DistributedType.DEEPSPEED else accelerator.num_processes
+        total = max(1, num_epochs * math.ceil(len(dataloader) / accelerator.num_processes) * k)
+        warm, floor = args.lr_warmup_steps * k, args.min_lr_ratio
+
+        def lr_lambda(step):
+            if step < warm:
+                return (step + 1) / warm
+            p = min(1.0, (step - warm) / max(1, total - warm))
+            return floor + (1 - floor) * 0.5 * (1 + math.cos(math.pi * p))
+        scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, lr_lambda)
+        if accelerator.is_main_process:
+            print(f"[lr] cosine: total_steps={total} warmup={warm} min_lr_ratio={floor}", flush=True)
+    else:
+        scheduler = torch.optim.lr_scheduler.ConstantLR(optimizer)
 
     if enable_model_cpu_offload:
         optimizer, dataloader, scheduler = accelerator.prepare(optimizer, dataloader, scheduler)
