+                    break
+                except Exception as e:
+                    if attempt == 11:
+                        raise
+                    print(f"[UnifiedDataset] load failed for item {data_id + attempt} "
+                          f"(attempt {attempt + 1}/12): {e}", flush=True)
+                    time.sleep(min(30, 2 ** attempt))
         return data
 
