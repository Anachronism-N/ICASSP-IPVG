+    def zero_star_guidance(positive, negative, scale):
+        pos, neg = positive.float(), negative.float()
+        axes = tuple(range(1, pos.ndim))
+        optimal = (pos * neg).sum(dim=axes, keepdim=True) / (neg.square().sum(dim=axes, keepdim=True) + 1e-8)
+        scaled_negative = optimal * neg
+        return (scaled_negative + scale * (pos - scaled_negative)).to(positive.dtype)
